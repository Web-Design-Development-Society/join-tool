# Serverless — Deno Deploy v2
# Copy to .env and fill values. All placeholders are empty strings — fill before deploy.
# Loaded locally via: deno run --watch --allow-net --allow-env --env=.env main.ts
# For Deploy v2, set these as app env vars (production + development contexts) at console.deno.com or via `deno deploy env add`.

# GitHub OAuth App (wdd-identifier) — https://github.com/organizations/Web-Design-Development-Society/settings/applications
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# GitHub App (wdd-inviter) — https://github.com/organizations/Web-Design-Development-Society/settings/apps
# PRIVATE_KEY is a PEM string. Keep newlines: paste full -----BEGIN RSA PRIVATE KEY----- ... -----END RSA PRIVATE KEY-----
GITHUB_APP_PRIVATE_KEY=""
GITHUB_APP_ID=""
GITHUB_INSTALLATION_ID=""
GITHUB_ORG="Web-Design-Development-Society"

# Runtime mode for CORS. dev -> http://localhost:5173, otherwise https://web-design-development-society.github.io
MODE="dev"
